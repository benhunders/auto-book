# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Your Telegram Chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=your-chat-id-here

# SportCity credentials (for Phase 2 booking)
SPORTCITY_EMAIL=your-email@example.com
SPORTCITY_PASSWORD=your-password-here

# Schedule URL to monitor
SPORTCITY_SCHEDULE_URL=https://www.sportcity.nl/utrecht/leidsche-rijn-sportpark/groepslesrooster

# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# How many weeks ahead to check (default: 2)
WEEKS_AHEAD=2

# Lesson filtering is now done via Telegram commands:
#   /watch BodyPump    — add a lesson to watch
#   /unwatch BodyPump  — stop watching
#   /list              — show your watch list
