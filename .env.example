# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Your Telegram Chat ID (get from @userinfobot)
TELEGRAM_CHAT_ID=your-chat-id-here

# SportCity credentials (for Phase 2 booking)
SPORTCITY_EMAIL=your-email@example.com
SPORTCITY_PASSWORD=your-password-here

# Schedule URL to monitor
SPORTCITY_SCHEDULE_URL=https://www.sportcity.nl/utrecht/leidsche-rijn-sportpark/groepslesrooster

# Polling interval in seconds (default: 300 = 5 minutes)
POLL_INTERVAL_SECONDS=300

# Optional: filter lessons by name (comma-separated, case-insensitive)
# LESSON_FILTER=yoga,spinning,bodypump
